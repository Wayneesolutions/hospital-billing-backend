DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="change-this-to-a-long-random-string-in-production"
PORT=4000

# Final-bill PDFs are stored in this S3 bucket (private — access is via
# short-lived presigned URLs, never a public link). On App Runner/ECS, grant
# access via an attached IAM role rather than setting static AWS keys below.
AWS_REGION="ap-south-1"
S3_BILLS_BUCKET="your-hospital-billing-bills-bucket"
# Only needed for local development if you haven't run `aws configure`:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Comma-separated list of allowed frontend origins, e.g. https://yourapp.com,http://localhost:5173
# Use "*" only for local development.
CORS_ORIGIN="http://localhost:5173"

# Used only by `npm run seed` to create the first accounts_admin login.
SEED_ADMIN_EMAIL="admin@hospital.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
